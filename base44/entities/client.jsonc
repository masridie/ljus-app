// Cliente que reserva (hoy: agente inmobiliario).
{
  "name": "Client",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "Email del usuario dueño del perfil"
    },
    "nombre": {
      "type": "string"
    },
    "inmobiliaria": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp con código de país, ej. +5491122334455"
    }
  },
  "required": ["user_email", "nombre"],
  "rls": {
    "create": { "data.user_email": "{{user.email}}" },
    "read": {
      "$or": [
        { "data.user_email": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "data.user_email": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
